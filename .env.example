# Copiar este archivo como .env y completar los valores.
# El archivo .env NUNCA se sube a git (contiene contraseñas).

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=flota

# Opcional: si se define, reemplaza a los DB_* de arriba.
# DATABASE_URL=postgresql+psycopg://usuario:clave@servidor:5432/flota

# Porcentaje de desvío sobre el consumo de referencia a partir del cual se marca una alerta.
UMBRAL_DESVIO_PCT=15
# Tolerancia (%) sobre la capacidad del tanque para aceptar una carga.
TOLERANCIA_TANQUE_PCT=5

# Clave para firmar las sesiones del panel y los tokens de la API (RNF-03).
# Generarla con:  uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# En producción (con HTTPS): COOKIES_SEGURAS=true
COOKIES_SEGURAS=false
